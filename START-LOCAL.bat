@echo off
set "QUIET_NOTES_ROOT=%~dp0"
title Quiet Notes - Local Server
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; $root=[IO.Path]::GetFullPath($env:QUIET_NOTES_ROOT); $listener=[Net.Sockets.TcpListener]::new([Net.IPAddress]::Loopback,8811); try {$listener.Start()} catch {Write-Host 'Port 8811 is busy. Close the previous window and retry.'; exit 1}; Write-Host 'Keep this window open. Close it to stop. Browser: http://127.0.0.1:8811/index.html'; Start-Process 'http://127.0.0.1:8811/index.html'; while($true){$client=$listener.AcceptTcpClient(); try {$stream=$client.GetStream(); $stream.ReadTimeout=3000; $reader=[IO.StreamReader]::new($stream); $line=$reader.ReadLine(); if(!$line){continue}; do {$h=$reader.ReadLine()} while($h); $url=($line -split ' ')[1]; $relative=[Uri]::UnescapeDataString(($url -split '\?')[0]).TrimStart('/').Replace('/',[IO.Path]::DirectorySeparatorChar); if(!$relative){$relative='index.html'}; $full=[IO.Path]::GetFullPath([IO.Path]::Combine($root,$relative)); $ext=[IO.Path]::GetExtension($full).ToLower(); $types=@{'.html'='text/html; charset=utf-8';'.css'='text/css; charset=utf-8';'.js'='text/javascript; charset=utf-8';'.txt'='text/plain; charset=utf-8';'.md'='text/plain; charset=utf-8'}; if($full.StartsWith($root,[StringComparison]::OrdinalIgnoreCase) -and [IO.File]::Exists($full) -and $types.ContainsKey($ext)){$body=[IO.File]::ReadAllBytes($full); $status='200 OK'; $mime=$types[$ext]}else{$body=[Text.Encoding]::UTF8.GetBytes('Not found');$status='404 Not Found';$mime='text/plain'}; $header=[Text.Encoding]::ASCII.GetBytes(('HTTP/1.1 '+$status+[char]13+[char]10+'Content-Type: '+$mime+[char]13+[char]10+'Content-Length: '+$body.Length+[char]13+[char]10+'Cache-Control: no-store'+[char]13+[char]10+'Connection: close'+[char]13+[char]10+[char]13+[char]10)); $stream.Write($header,0,$header.Length);$stream.Write($body,0,$body.Length);$stream.Flush()}catch{Write-Host $_.Exception.Message}finally{$client.Close()}}"
pause
